{
  "schemaVersion": "1.0",
  "assignmentId": "movie-watchlist-v1",
  "version": 1,
  "status": "APPROVED",
  "technology": "JAVA",
  "framework": "NONE",
  "evaluationMode": "CLI",
  "runtime": {
    "image": "apexeval/student-workspace:latest",
    "version": "17",
    "env": {}
  },
  "build": {
    "commands": ["mvn compile"],
    "workingDirectory": "/workspace/movie-watchlist-assignment",
    "env": {}
  },
  "test": {
    "commands": ["mvn test"],
    "workingDirectory": "/workspace/movie-watchlist-assignment",
    "env": {},
    "reportFormat": "junit",
    "reportPath": "target/surefire-reports"
  },
  "limits": {
    "timeoutSeconds": 60,
    "memoryMb": 1024,
    "cpuCores": 1.0,
    "maxOutputBytes": 1000000,
    "maxProcesses": 100,
    "networkEnabled": false,
    "privileged": false
  },
  "hiddenTests": {
    "version": "1",
    "path": "movie-watchlist-assignment/hidden-tests/com/apexeval/assignment/MovieWatchlistManagementSystemTest.java",
    "testClass": "com.apexeval.assignment.MovieWatchlistManagementSystemTest"
  },
  "requiredRules": [
    {
      "rule": "USES_TYPE",
      "value": "ArrayList",
      "severity": "FLAG",
      "message": "Use ArrayList<String> to store movie names"
    },
    {
      "rule": "HAS_CLASS",
      "value": "MovieWatchlistManagementSystem",
      "severity": "FLAG",
      "message": "Class MovieWatchlistManagementSystem is required"
    },
    {
      "rule": "HAS_METHOD",
      "value": "main",
      "severity": "FLAG",
      "message": "main(String[] args) method is required"
    },
    {
      "rule": "EXTENDS_TYPE",
      "target": "DuplicateMovieException",
      "value": "Exception",
      "severity": "FLAG",
      "message": "DuplicateMovieException must extend Exception"
    },
    {
      "rule": "EXTENDS_TYPE",
      "target": "MovieNotFoundException",
      "value": "Exception",
      "severity": "FLAG",
      "message": "MovieNotFoundException must extend Exception"
    },
    {
      "rule": "METHOD_FORBIDDEN",
      "valueList": ["addMovie", "removeMovie", "searchMovie", "displayMovieCount", "sortMovies", "displayMovies"],
      "severity": "FLAG",
      "message": "Business operations must be implemented directly inside main(), not as separate methods"
    }
  ],
  "suspiciousRules": [
    {
      "rule": "CONSTANT_RETURN",
      "severity": "FLAG",
      "message": "Method appears to return a hardcoded constant"
    },
    {
      "rule": "PRINT_ONLY_METHOD",
      "severity": "FLAG",
      "message": "Method contains only a print statement"
    },
    {
      "rule": "EMPTY_METHOD",
      "severity": "FLAG",
      "message": "Method body is empty"
    }
  ],
  "dbVerification": {
    "applicable": false,
    "strategy": "NO_OP",
    "config": {}
  },
  "metadata": {
    "courseId": "crs-101",
    "courseName": "Programming Fundamentals",
    "title": "Movie Watchlist Manager (Java)",
    "description": "Build a movie watchlist application that allows users to add, remove, search, and list movies.",
    "difficulty": "MEDIUM",
    "week": 2,
    "day": 3
  }
}